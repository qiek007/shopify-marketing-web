<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<c:choose>
    <c:when test="${empty recipientPage.items}">
        <div class="empty-state"><i class="fa fa-inbox"></i><strong>没有收件人记录</strong><span>当前筛选条件没有匹配数据。</span></div>
    </c:when>
    <c:otherwise>
        <div class="table-wrap"><table class="status-table campaign-recipient-table"><thead><tr><th>客户</th><th>送达</th><th>打开</th><th>点击</th><th>下单转化</th><th>异常</th></tr></thead><tbody>
        <c:forEach items="${recipientPage.items}" var="recipient">
            <c:url var="customerPageUrl" value="/customers/detail"><c:param name="shop" value="${shopDomain}"/><c:param name="customerId" value="${recipient.customerSourceId}"/></c:url>
            <c:url var="campaignCustomerDetailUrl" value="/campaigns/detail/customer"><c:param name="shop" value="${shopDomain}"/><c:param name="customerId" value="${recipient.customerSourceId}"/></c:url>
            <tr><td><c:choose><c:when test="${canViewCustomers}"><a href="${customerPageUrl}" data-campaign-customer-detail data-detail-url="${campaignCustomerDetailUrl}"><strong><c:out value="${recipient.customerName}"/></strong></a></c:when><c:otherwise><strong><c:out value="${recipient.customerName}"/></strong></c:otherwise></c:choose><span class="cell-note"><c:out value="${recipient.email}"/> · <c:out value="${recipient.customerSourceId}"/></span></td><td><time data-browser-time="<c:out value='${recipient.deliveredAt}'/>" datetime="<c:out value='${recipient.deliveredAt}'/>"><c:out value="${recipient.deliveredAt}" default="-"/></time></td><td><c:out value="${recipient.openCount}"/> 次<span class="cell-note"><time data-browser-time="<c:out value='${recipient.openedAt}'/>" datetime="<c:out value='${recipient.openedAt}'/>"><c:out value="${recipient.openedAt}"/></time></span></td><td><c:out value="${recipient.clickCount}"/> 次<span class="cell-note"><time data-browser-time="<c:out value='${recipient.clickedAt}'/>" datetime="<c:out value='${recipient.clickedAt}'/>"><c:out value="${recipient.clickedAt}"/></time></span></td><td><c:choose><c:when test="${recipient.converted}"><strong><c:out value="${recipient.orderCount}"/> 单</strong><span class="cell-note"><c:out value="${recipient.netRevenue}"/> · <time data-browser-time="<c:out value='${recipient.lastOrderAt}'/>" datetime="<c:out value='${recipient.lastOrderAt}'/>"><c:out value="${recipient.lastOrderAt}"/></time></span></c:when><c:otherwise>-</c:otherwise></c:choose></td><td><c:out value="${recipient.lastErrorCode}" default="-"/><span class="cell-note"><c:if test="${not empty recipient.bouncedAt}">退信 <time data-browser-time="<c:out value='${recipient.bouncedAt}'/>" datetime="<c:out value='${recipient.bouncedAt}'/>"><c:out value="${recipient.bouncedAt}"/></time></c:if><c:if test="${not empty recipient.complainedAt}">投诉 <time data-browser-time="<c:out value='${recipient.complainedAt}'/>" datetime="<c:out value='${recipient.complainedAt}'/>"><c:out value="${recipient.complainedAt}"/></time></c:if><c:if test="${not empty recipient.unsubscribedAt}">退订 <time data-browser-time="<c:out value='${recipient.unsubscribedAt}'/>" datetime="<c:out value='${recipient.unsubscribedAt}'/>"><c:out value="${recipient.unsubscribedAt}"/></time></c:if></span></td></tr>
        </c:forEach>
        </tbody></table></div>
        <c:if test="${recipientPage.totalPages gt 1}"><nav class="pagination"><c:if test="${recipientPage.hasPrevious}"><a href="#" data-campaign-recipient-page="${recipientPage.page - 1}">上一页</a></c:if><span>第 <c:out value="${recipientPage.page}"/> / <c:out value="${recipientPage.totalPages}"/> 页</span><c:if test="${recipientPage.hasNext}"><a href="#" data-campaign-recipient-page="${recipientPage.page + 1}">下一页</a></c:if></nav></c:if>
    </c:otherwise>
</c:choose>
