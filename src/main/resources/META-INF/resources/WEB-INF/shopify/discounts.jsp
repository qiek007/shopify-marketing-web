<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>优惠活动 - Shopify 邮件营销</title><c:set var="ctx" value="${pageContext.request.contextPath}"/><link rel="stylesheet" href="${ctx}/baseui/static/h-ui/css/H-ui.min.css"><link rel="stylesheet" href="${ctx}/baseui/static/h-ui.admin/css/H-ui.admin.css"><link rel="stylesheet" href="${ctx}/baseui/lib/font-awesome-4.7.0/css/font-awesome.min.css"><link rel="stylesheet" href="${ctx}${uiAssetBase}/css/dashboard.css?v=20260923-discounts-v2"></head>
<body class="shopify-console"><%@ include file="fragments/header.jspf" %><div class="console-layout"><%@ include file="fragments/navigation.jspf" %><main class="console-main"><section class="page-heading"><div><p class="eyebrow">店铺数据</p><h1>优惠活动</h1><p>查看从 Shopify 同步的优惠码、有效期和当前状态</p></div></section><section class="content-section"><div class="section-heading"><div><h2>优惠活动列表</h2><p>列表数据来自最近一次店铺同步</p></div><span class="section-count">共 <c:out value="${discounts.total}"/> 个</span></div><form class="filter-form discount-filter-form" method="get"><input type="hidden" name="shop" value="${selectedShop}"><input type="hidden" name="page" value="1"><input name="q" value="<c:out value='${search}'/>" placeholder="优惠名称、优惠码、说明或 ID"><select name="status"><option value="" ${empty discountStatus ? 'selected' : ''}>全部状态</option><option value="ACTIVE" ${discountStatus eq 'ACTIVE' ? 'selected' : ''}>生效中</option><option value="SCHEDULED" ${discountStatus eq 'SCHEDULED' ? 'selected' : ''}>待生效</option><option value="EXPIRED" ${discountStatus eq 'EXPIRED' ? 'selected' : ''}>已结束</option><option value="INACTIVE" ${discountStatus eq 'INACTIVE' ? 'selected' : ''}>未启用</option></select><div class="filter-actions"><button class="action-button" type="submit"><i class="fa fa-search"></i><span>查询</span></button><a class="action-button" href="${ctx}/discounts?shop=${selectedShop}"><i class="fa fa-undo"></i><span>清空条件</span></a></div></form><c:choose><c:when test="${empty discounts.items}"><div class="empty-state"><i class="fa fa-ticket"></i><strong>没有找到优惠活动</strong><span>可调整查询条件，或前往“我的店铺”手动同步最新优惠。</span></div></c:when><c:otherwise><div class="table-wrap"><table class="status-table wide-table"><thead><tr><th>优惠活动</th><th>优惠码</th><th>状态</th><th>生效时间</th><th>结束时间</th><th>最近同步</th></tr></thead><tbody><c:forEach items="${discounts.items}" var="discount"><tr><td><strong><c:out value="${discount.title}" default="未命名优惠"/></strong><span class="cell-note"><c:out value="${discount.summary}" default="${discount.sourceId}"/></span></td><td><code><c:out value="${discount.code}" default="-"/></code></td><td><span class="status-pill ${discount.status eq 'ACTIVE' ? '' : 'neutral'}"><c:out value="${discount.status}" default="UNKNOWN"/></span></td><td><time data-browser-time="<c:out value='${discount.startsAt}'/>" datetime="<c:out value='${discount.startsAt}'/>"><c:out value="${discount.startsAt}" default="立即生效"/></time></td><td><time data-browser-time="<c:out value='${discount.endsAt}'/>" datetime="<c:out value='${discount.endsAt}'/>"><c:out value="${discount.endsAt}" default="长期有效"/></time></td><td><time data-browser-time="<c:out value='${discount.sourceUpdatedAt}'/>" datetime="<c:out value='${discount.sourceUpdatedAt}'/>"><c:out value="${discount.sourceUpdatedAt}" default="-"/></time></td></tr></c:forEach></tbody></table></div><c:url var="discountPreviousUrl" value="/discounts"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${search}"/><c:param name="status" value="${discountStatus}"/><c:param name="page" value="${discounts.page - 1}"/><c:param name="size" value="${discounts.pageSize}"/></c:url><c:url var="discountNextUrl" value="/discounts"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${search}"/><c:param name="status" value="${discountStatus}"/><c:param name="page" value="${discounts.page + 1}"/><c:param name="size" value="${discounts.pageSize}"/></c:url><div class="pagination-bar"><c:if test="${discounts.hasPrevious}"><a class="action-button" href="${discountPreviousUrl}">上一页</a></c:if><span>共 <c:out value="${discounts.total}"/> 项，第 <c:out value="${discounts.page}"/> / <c:out value="${discounts.totalPages}"/> 页</span><c:if test="${discounts.hasNext}"><a class="action-button" href="${discountNextUrl}">下一页</a></c:if></div></c:otherwise></c:choose></section></main></div></body></html>
