<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/><c:set var="mobilePage" value="customers"/>
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>客户 · 滴答营销</title><link rel="stylesheet" href="${ctx}/shopify/mobile/mobile.css?v=20261108-customers2"><link rel="stylesheet" href="${ctx}/shopify/mobile/customers.css?v=20261108-flow2"></head><body>
<%@ include file="fragments/header.jspf" %>
<main class="mobile-main" data-mobile-customer-list>
    <section class="mobile-page-title"><p class="mobile-eyebrow">CUSTOMERS / 客户</p><h1>客户列表</h1><p>查看客户资料、订单和行为</p></section>
    <c:choose><c:when test="${empty selectedShop}"><section class="mobile-empty"><strong>暂无可用店铺</strong><p>请联系店铺管理员授权。</p></section></c:when><c:otherwise>
    <form id="mobile-customer-filter" class="mc-form" method="get" action="${ctx}/mobile/customers">
        <input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><input type="hidden" name="page" value="1"><input type="hidden" name="query" value="1">
        <label>姓名或邮箱<input type="search" name="q" value="<c:out value='${customerFilter.search}'/>" placeholder="搜索姓名或邮箱"></label>
        <label>行为类型<select name="activity">
            <option value="">不限</option>
            <option value="VIEWED" <c:if test="${customerFilter.activity eq 'VIEWED'}">selected</c:if>>有浏览记录</option>
            <option value="CARTED" <c:if test="${customerFilter.activity eq 'CARTED'}">selected</c:if>>有加入购物车记录</option>
            <option value="ORDERED" <c:if test="${customerFilter.activity eq 'ORDERED'}">selected</c:if>>有订单记录</option>
            <option value="EMAIL_DELIVERED" <c:if test="${customerFilter.activity eq 'EMAIL_DELIVERED'}">selected</c:if>>已送达邮件</option>
            <option value="EMAIL_OPENED" <c:if test="${customerFilter.activity eq 'EMAIL_OPENED'}">selected</c:if>>已打开邮件</option>
            <option value="EMAIL_CLICKED" <c:if test="${customerFilter.activity eq 'EMAIL_CLICKED'}">selected</c:if>>已点击链接</option>
            <option value="EMAIL_FAILED" <c:if test="${customerFilter.activity eq 'EMAIL_FAILED'}">selected</c:if>>发送失败／退信</option>
            <option value="EMAIL_DELIVERED_NOT_OPENED" <c:if test="${customerFilter.activity eq 'EMAIL_DELIVERED_NOT_OPENED'}">selected</c:if>>最近送达未打开</option>
            <option value="EMAIL_OPENED_NOT_CLICKED" <c:if test="${customerFilter.activity eq 'EMAIL_OPENED_NOT_CLICKED'}">selected</c:if>>最近打开未点击</option>
        </select></label>
        <p class="mc-hint">邮件打开数据可能受邮箱隐私代理影响，仅作筛选参考。</p>
        <details <c:if test="${not empty customerFilter.fromDate or not empty customerFilter.toDate or not empty customerFilter.minSpent or not empty customerFilter.maxSpent or not empty customerFilter.tags or not empty customerFilter.minBehaviorCount or not empty customerFilter.maxBehaviorCount or not empty customerFilter.minUniqueBehaviorCount or not empty customerFilter.maxUniqueBehaviorCount}">open</c:if>><summary>更多筛选</summary>
            <label><span data-date-label>最近活动日期范围</span><span class="mc-range"><input type="date" name="fromDate" aria-label="开始日期" value="<c:out value='${customerFilter.fromDate}'/>"><input type="date" name="toDate" aria-label="结束日期" value="<c:out value='${customerFilter.toDate}'/>"></span><small class="mc-hint" data-date-hint>按最近活动时间筛选，无活动记录时按客户资料更新时间</small></label>
            <label>累计有效订单金额<span class="mc-range"><input type="number" name="minSpent" min="0" step="0.01" aria-label="金额下限" value="<c:out value='${customerFilter.minSpent}'/>"><input type="number" name="maxSpent" min="0" step="0.01" aria-label="金额上限" value="<c:out value='${customerFilter.maxSpent}'/>"></span><small class="mc-hint">未取消且处于有效财务状态的订单总金额。</small></label>
            <c:set var="untaggedSelected" value="false"/>
            <c:forEach items="${customerFilter.tags}" var="tag"><c:choose><c:when test="${tag eq '__UNTAGGED__'}"><c:set var="untaggedSelected" value="true"/></c:when><c:otherwise><label>已选客户标签<input name="tag" data-tag-input maxlength="100" value="<c:out value='${tag}'/>"></label></c:otherwise></c:choose></c:forEach>
            <label>客户标签<input name="tag" data-tag-input maxlength="100" placeholder="输入精确标签，可留空"></label>
            <label class="mc-checkbox"><input type="checkbox" name="tag" value="__UNTAGGED__" data-untagged-filter <c:if test="${untaggedSelected}">checked</c:if>><span>仅无标签客户</span></label>
            <label data-count-filter hidden><span>行为总次数</span><span class="mc-range"><input type="number" name="minBehaviorCount" min="0" step="1" aria-label="次数下限" value="<c:out value='${customerFilter.minBehaviorCount}'/>" disabled><input type="number" name="maxBehaviorCount" min="0" step="1" aria-label="次数上限" value="<c:out value='${customerFilter.maxBehaviorCount}'/>" disabled></span></label>
            <label data-count-filter hidden><span data-unique-label>去重对象数</span><span class="mc-range"><input type="number" name="minUniqueBehaviorCount" min="0" step="1" aria-label="去重对象下限" value="<c:out value='${customerFilter.minUniqueBehaviorCount}'/>" disabled><input type="number" name="maxUniqueBehaviorCount" min="0" step="1" aria-label="去重对象上限" value="<c:out value='${customerFilter.maxUniqueBehaviorCount}'/>" disabled></span></label>
        </details>
        <c:url var="resetCustomerUrl" value="/mobile/customers"><c:param name="shop" value="${selectedShop}"/></c:url>
        <div class="mc-actions"><button class="mc-button primary" type="submit">查询客户</button><a class="mc-button" href="<c:out value='${resetCustomerUrl}'/>">清空筛选</a></div>
    </form>
    <c:choose><c:when test="${not customerResultsLoaded}"><section class="mobile-empty" data-customer-query-prompt><strong>按条件查询客户</strong><p>设置筛选条件后，点击“查询客户”加载列表。</p></section></c:when>
    <c:when test="${not behaviorFilterAvailable}"><div class="mc-alert" role="alert">客户行为数据暂不可用，请稍后重试。<c:out value="${behaviorFilterMessage}"/></div></c:when>
    <c:when test="${empty customers}"><section class="mobile-empty"><strong>没有找到客户</strong><p>可调整筛选条件后重试。</p></section></c:when><c:otherwise>
        <p class="mc-meta"><c:choose><c:when test="${customerPage.totalExact}">共 <c:out value="${customerPage.total}"/> 位客户</c:when><c:otherwise>当前查询结果总数尚未确定</c:otherwise></c:choose></p>
        <c:forEach items="${customers}" var="customer">
            <c:url var="customerUrl" value="/mobile/customers/detail"><c:param name="shop" value="${selectedShop}"/><c:param name="customerId" value="${customer.sourceId}"/><c:param name="q" value="${customerFilter.search}"/><c:param name="activity" value="${customerFilter.activity}"/><c:forEach items="${customerFilter.tags}" var="tag"><c:param name="tag" value="${tag}"/></c:forEach><c:param name="fromDate" value="${customerFilter.fromDate}"/><c:param name="toDate" value="${customerFilter.toDate}"/><c:param name="minSpent" value="${customerFilter.minSpent}"/><c:param name="maxSpent" value="${customerFilter.maxSpent}"/><c:param name="minBehaviorCount" value="${customerFilter.minBehaviorCount}"/><c:param name="maxBehaviorCount" value="${customerFilter.maxBehaviorCount}"/><c:param name="minUniqueBehaviorCount" value="${customerFilter.minUniqueBehaviorCount}"/><c:param name="maxUniqueBehaviorCount" value="${customerFilter.maxUniqueBehaviorCount}"/><c:param name="page" value="${customerPage.page}"/><c:param name="query" value="1"/></c:url>
            <a class="mc-card" href="<c:out value='${customerUrl}'/>"><h2><c:out value="${customer.displayName}"/></h2><p><c:out value="${customer.email}" default="无邮箱"/></p>
                <div class="mc-row"><span class="mc-tag"><c:choose><c:when test="${customer.consentState eq 'SUBSCRIBED'}">已订阅</c:when><c:when test="${customer.consentState eq 'NOT_SUBSCRIBED'}">未订阅</c:when><c:when test="${customer.consentState eq 'UNSUBSCRIBED'}">已退订</c:when><c:when test="${empty customer.consentState or customer.consentState eq 'UNKNOWN'}">未知</c:when><c:otherwise><c:out value="${customer.consentState}"/></c:otherwise></c:choose></span><c:if test="${customer.suppressed}"><span class="mc-tag">已抑制</span></c:if><c:forEach items="${customer.tags}" var="tag"><span class="mc-tag"><c:out value="${tag}"/></span></c:forEach></div>
                <p class="mc-meta">订单 <c:out value="${customer.orderCount}"/> · 累计消费 <c:out value="${customer.totalSpent}"/> <c:out value="${customer.currency}"/></p>
                <p class="mc-meta">最近购买：<c:choose><c:when test="${not empty customer.recencyDays}"><c:out value="${customer.recencyDays}"/> 天前</c:when><c:otherwise>暂无</c:otherwise></c:choose> · 查看详情 →</p>
            </a>
        </c:forEach>
        <c:url var="previousUrl" value="/mobile/customers"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${customerFilter.search}"/><c:param name="activity" value="${customerFilter.activity}"/><c:forEach items="${customerFilter.tags}" var="tag"><c:param name="tag" value="${tag}"/></c:forEach><c:param name="fromDate" value="${customerFilter.fromDate}"/><c:param name="toDate" value="${customerFilter.toDate}"/><c:param name="minSpent" value="${customerFilter.minSpent}"/><c:param name="maxSpent" value="${customerFilter.maxSpent}"/><c:param name="minBehaviorCount" value="${customerFilter.minBehaviorCount}"/><c:param name="maxBehaviorCount" value="${customerFilter.maxBehaviorCount}"/><c:param name="minUniqueBehaviorCount" value="${customerFilter.minUniqueBehaviorCount}"/><c:param name="maxUniqueBehaviorCount" value="${customerFilter.maxUniqueBehaviorCount}"/><c:param name="page" value="${customerPage.page - 1}"/><c:param name="query" value="1"/></c:url>
        <c:url var="nextUrl" value="/mobile/customers"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${customerFilter.search}"/><c:param name="activity" value="${customerFilter.activity}"/><c:forEach items="${customerFilter.tags}" var="tag"><c:param name="tag" value="${tag}"/></c:forEach><c:param name="fromDate" value="${customerFilter.fromDate}"/><c:param name="toDate" value="${customerFilter.toDate}"/><c:param name="minSpent" value="${customerFilter.minSpent}"/><c:param name="maxSpent" value="${customerFilter.maxSpent}"/><c:param name="minBehaviorCount" value="${customerFilter.minBehaviorCount}"/><c:param name="maxBehaviorCount" value="${customerFilter.maxBehaviorCount}"/><c:param name="minUniqueBehaviorCount" value="${customerFilter.minUniqueBehaviorCount}"/><c:param name="maxUniqueBehaviorCount" value="${customerFilter.maxUniqueBehaviorCount}"/><c:param name="page" value="${customerPage.page + 1}"/><c:param name="query" value="1"/></c:url>
        <nav class="mc-actions" aria-label="客户列表分页"><c:if test="${customerPage.hasPrevious}"><a class="mc-button" href="<c:out value='${previousUrl}'/>">上一页</a></c:if><span>第 <c:out value="${customerPage.page}"/> 页<c:if test="${customerPage.totalExact}"> / <c:out value="${customerPage.totalPages}"/> 页</c:if></span><c:if test="${customerPage.hasNext}"><a class="mc-button" href="<c:out value='${nextUrl}'/>">下一页</a></c:if></nav>
    </c:otherwise></c:choose>
    </c:otherwise></c:choose>
</main><%@ include file="fragments/footer.jspf" %><script src="${ctx}/shopify/mobile/customers.js?v=20261108-customers2" defer></script></body></html>
