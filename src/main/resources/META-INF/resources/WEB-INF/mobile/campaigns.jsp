<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/><c:set var="mobilePage" value="campaigns"/>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>营销活动 · 滴答营销</title><link rel="stylesheet" href="${ctx}/shopify/mobile/mobile.css?v=20261108"><link rel="stylesheet" href="${ctx}/shopify/mobile/status.css?v=20261108-status"></head><body>
<%@ include file="fragments/header.jspf" %>
<main class="mobile-main" data-mobile-list>
    <section class="mobile-page-title mobile-title-row"><div><p class="mobile-eyebrow">CAMPAIGNS / 营销活动</p><h1>活动列表</h1><p>共 <c:out value="${campaignPage.total}" default="0"/> 个活动</p></div><c:if test="${not empty selectedShop and canManageCampaigns}"><c:url var="createUrl" value="/mobile/campaigns/editor"><c:param name="shop" value="${selectedShop}"/></c:url><a class="mobile-button primary" href="<c:out value='${createUrl}'/>">＋ 创建</a></c:if></section>
    <c:if test="${not empty successMessage}"><div class="mobile-notice" role="status"><c:out value="${successMessage}"/></div></c:if><c:if test="${not empty errorMessage}"><div class="mobile-notice error" role="alert"><c:out value="${errorMessage}"/></div></c:if>
    <c:if test="${not empty selectedShop}"><form class="mobile-filter" action="${ctx}/mobile/campaigns" method="get"><input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><input type="hidden" name="page" value="1"><input type="hidden" name="size" value="<c:out value='${campaignPage.pageSize}'/>">
        <label>搜索活动<input type="search" name="q" value="<c:out value='${campaignSearch}'/>" placeholder="活动名称"></label><label>活动状态<select name="status"><option value="">全部状态</option><c:forEach items="${campaignStatuses}" var="item"><option value="<c:out value='${item.name}'/>" <c:if test="${campaignStatus eq item.name}">selected</c:if>><c:out value="${item.displayName}"/></option></c:forEach></select></label>
        <details <c:if test="${not empty campaignFromDate or not empty campaignToDate}">open</c:if>><summary>日期筛选<c:if test="${not empty campaignFromDate or not empty campaignToDate}"> · 已设置</c:if></summary><div class="mobile-filter-dates"><label>更新开始日期<input type="date" name="fromDate" value="<c:out value='${campaignFromDate}'/>"></label><label>更新结束日期<input type="date" name="toDate" value="<c:out value='${campaignToDate}'/>"></label></div></details>
        <div class="mobile-filter-actions"><button class="mobile-button" type="submit">查询</button><a class="mobile-button" href="<c:out value='${mobileCampaignUrl}'/>">清空筛选</a></div>
    </form></c:if>
    <c:choose><c:when test="${empty selectedShop}"><div class="mobile-empty"><strong>暂无可用店铺</strong><p>请联系店铺管理员授权。</p></div></c:when><c:when test="${empty campaigns}"><div class="mobile-empty"><strong>没有找到活动</strong><p>可调整筛选条件或创建活动。</p></div></c:when><c:otherwise>
    <div class="mobile-campaigns"><c:forEach items="${campaigns}" var="campaign"><c:url var="detailUrl" value="/mobile/campaigns/detail"><c:param name="shop" value="${campaign.shopDomain}"/><c:param name="campaignId" value="${campaign.campaignId}"/></c:url><a class="mobile-campaign" href="<c:out value='${detailUrl}'/>"><div class="mobile-campaign-top"><strong><c:out value="${campaign.name}"/></strong><span class="mobile-status" data-campaign-status="<c:out value='${empty campaign.displayStatus ? campaign.status : campaign.displayStatus}'/>"><c:out value="${campaign.statusDisplayName}" default="${campaign.status}"/></span></div><p>模板 · <c:out value="${campaign.templateName}" default="—"/></p><div class="mobile-campaign-meta"><span>冻结受众 <c:choose><c:when test="${campaign.snapshotStatus eq 'BUILDING' or campaign.snapshotStatus eq 'PROCESSING'}">计算中</c:when><c:when test="${campaign.snapshotStatus eq 'FAILED'}">计算失败</c:when><c:otherwise><c:out value="${campaign.audienceCount}" default="—"/></c:otherwise></c:choose></span><span><time data-browser-time="<c:out value='${campaign.updatedAt}'/>" datetime="<c:out value='${campaign.updatedAt}'/>"><c:out value="${campaign.updatedAt}"/></time>　→</span></div><c:if test="${campaign.archiveAuditMismatch}"><p class="mobile-warning"><c:out value="${campaign.archiveAuditNote}" default="活动数据核验有差异"/></p></c:if></a></c:forEach></div>
    <c:url var="previousUrl" value="/mobile/campaigns"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${campaignSearch}"/><c:param name="status" value="${campaignStatus}"/><c:param name="fromDate" value="${campaignFromDate}"/><c:param name="toDate" value="${campaignToDate}"/><c:param name="page" value="${campaignPage.page - 1}"/><c:param name="size" value="${campaignPage.pageSize}"/></c:url><c:url var="nextUrl" value="/mobile/campaigns"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${campaignSearch}"/><c:param name="status" value="${campaignStatus}"/><c:param name="fromDate" value="${campaignFromDate}"/><c:param name="toDate" value="${campaignToDate}"/><c:param name="page" value="${campaignPage.page + 1}"/><c:param name="size" value="${campaignPage.pageSize}"/></c:url><div class="mobile-pagination"><c:if test="${campaignPage.hasPrevious}"><a href="<c:out value='${previousUrl}'/>">上一页</a></c:if><span>第 <c:out value="${campaignPage.page}"/> / <c:out value="${campaignPage.totalPages}"/> 页</span><c:if test="${campaignPage.hasNext}"><a href="<c:out value='${nextUrl}'/>">下一页</a></c:if></div>
    </c:otherwise></c:choose>
</main><%@ include file="fragments/footer.jspf" %></body></html>
