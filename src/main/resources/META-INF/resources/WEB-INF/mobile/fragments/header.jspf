<header class="mobile-header">
    <div class="mobile-brand"><span class="mobile-brand-mark" aria-hidden="true">D</span><div><strong>滴答营销</strong><small>商户工作台</small></div></div>
    <c:choose>
        <c:when test="${not empty accessibleShops}">
            <form class="mobile-shop" method="get" action="${ctx}/mobile/dashboard">
                <label for="mobile-shop-select">当前店铺</label>
                <div class="mobile-shop-row"><select id="mobile-shop-select" name="shop">
                    <c:forEach items="${accessibleShops}" var="shopItem"><option value="<c:out value='${shopItem.shopDomain}'/>" <c:if test="${shopItem.shopDomain eq selectedShop}">selected</c:if>><c:out value="${shopItem.displayName}" default="${shopItem.shopDomain}"/></option></c:forEach>
                </select><button type="submit">切换</button></div>
            </form>
        </c:when>
        <c:otherwise><p class="mobile-no-shop">暂无可用店铺</p></c:otherwise>
    </c:choose>
</header>
<nav class="mobile-nav" aria-label="营销工作台导航">
    <c:url var="mobileHomeUrl" value="/mobile/dashboard"><c:param name="shop" value="${selectedShop}"/></c:url>
    <c:url var="mobileCampaignUrl" value="/mobile/campaigns"><c:param name="shop" value="${selectedShop}"/></c:url>
    <a href="<c:out value='${mobileHomeUrl}'/>" <c:if test="${mobilePage eq 'dashboard'}">aria-current="page"</c:if>>数据总览</a>
    <a href="<c:out value='${mobileCampaignUrl}'/>" <c:if test="${mobilePage eq 'campaigns'}">aria-current="page"</c:if>>营销活动</a>
</nav>
<script id="session-keepalive" src="${ctx}/shopify/js/session-keepalive.js" data-context-path="${ctx}" defer></script>
<script src="${ctx}/shopify/js/browser-time.js" defer></script>
