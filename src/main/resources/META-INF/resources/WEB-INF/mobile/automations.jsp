<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/><c:set var="mobilePage" value="automations"/>
<c:set var="hasPublishedTemplates" value="${false}"/><c:forEach items="${templates}" var="template"><c:if test="${template.status eq 'PUBLISHED'}"><c:set var="hasPublishedTemplates" value="${true}"/></c:if></c:forEach>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>自动营销</title><link rel="stylesheet" href="${ctx}/shopify/mobile/mobile.css?v=20261108"><link rel="stylesheet" href="${ctx}/shopify/mobile/automations.css?v=20261110-heading"></head>
<body><%@ include file="fragments/header.jspf" %><main class="mobile-main" data-mobile-automations data-shop="<c:out value='${selectedShop}'/>" data-detail-url="${ctx}/automations/detail" data-customer-url="${ctx}/mobile/customers/detail" data-discount-url="${ctx}/templates/discounts" data-create-url="${ctx}/mobile/automations" data-update-url="${ctx}/mobile/automations/update">
  <p class="ma-eyebrow">营销工作台</p><div class="ma-page-heading"><h1>自动营销</h1><c:if test="${not empty selectedShop and canManageCampaigns}"><button type="button" class="ma-primary" data-automation-new disabled>新建自动营销</button></c:if></div><p class="ma-subtitle">查看旅程表现，管理自动发送规则。</p>
  <c:if test="${not empty successMessage}"><p class="ma-message" role="status"><c:out value="${successMessage}"/></p></c:if><c:if test="${not empty errorMessage}"><p class="ma-message ma-error" role="alert"><c:out value="${errorMessage}"/></p></c:if>
  <c:choose><c:when test="${empty selectedShop}"><section class="ma-panel"><p>请选择有权限的店铺以查看自动营销。</p></section></c:when><c:otherwise>
  <section class="ma-panel"><div class="ma-heading"><h2>规则列表</h2><span><c:out value="${automationPage.total}"/> 条</span></div>
    <form method="get" action="${ctx}/mobile/automations" class="ma-filter"><input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><label>名称<input name="name" value="<c:out value='${automationNameFilter}'/>" placeholder="搜索规则名称"></label><label>状态<select name="status"><option value="">全部状态</option><c:forEach items="${automationStatuses}" var="s"><option value="<c:out value='${s}'/>" <c:if test="${automationStatusFilter eq s}">selected</c:if>><c:choose><c:when test="${s eq 'ACTIVE'}">生效</c:when><c:when test="${s eq 'PAUSED'}">已暂停</c:when><c:when test="${s eq 'DRAFT'}">草稿</c:when><c:otherwise><c:out value="${s}"/></c:otherwise></c:choose></option></c:forEach></select></label><label>触发事件<select name="triggerEvent"><option value="">全部事件</option><c:forEach items="${behaviorEventTypes}" var="event"><option value="<c:out value='${event}'/>" <c:if test="${automationTriggerFilter eq event}">selected</c:if>><c:choose><c:when test="${event eq 'PAGE_VIEWED'}">浏览页面</c:when><c:when test="${event eq 'CLICKED'}">点击页面</c:when><c:when test="${event eq 'PRODUCT_VIEWED'}">查看商品</c:when><c:when test="${event eq 'SEARCH_SUBMITTED'}">提交搜索</c:when><c:when test="${event eq 'PRODUCT_ADDED_TO_CART'}">加入购物车</c:when><c:when test="${event eq 'CHECKOUT_STARTED'}">开始结账</c:when><c:when test="${event eq 'CHECKOUT_COMPLETED'}">完成结账</c:when><c:otherwise><c:out value="${event}"/></c:otherwise></c:choose></option></c:forEach></select></label><button type="submit" class="ma-secondary">筛选</button></form>
    <c:if test="${canManageCampaigns}"><c:if test="${empty senderSettings or not hasPublishedTemplates}"><p>请先在电脑端准备已发布模板和可用发件通道。</p></c:if></c:if>
  </section>
  <section class="ma-list" aria-label="自动营销规则"><c:choose><c:when test="${empty automations}"><p class="ma-panel">没有符合条件的规则。</p></c:when><c:otherwise><c:forEach items="${automations}" var="automation"><article class="ma-card" data-automation-row data-id="<c:out value='${automation.automationId}'/>">
    <div class="ma-heading"><h2><c:out value="${automation.name}"/></h2><span class="ma-status" data-status="<c:out value='${automation.status}'/>"><c:choose><c:when test="${automation.status eq 'ACTIVE'}">生效</c:when><c:when test="${automation.status eq 'PAUSED'}">已暂停</c:when><c:when test="${automation.status eq 'DRAFT'}">草稿</c:when><c:otherwise><c:out value="${automation.status}"/></c:otherwise></c:choose></span></div>
    <p><c:choose><c:when test="${automation.journeyType eq 'ABANDONED_CART'}">购物车挽回</c:when><c:when test="${automation.journeyType eq 'BROWSE_ABANDONMENT'}">浏览挽回</c:when><c:when test="${automation.journeyType eq 'POST_PURCHASE'}">购买后跟进</c:when><c:otherwise><c:out value="${automation.journeyType}"/></c:otherwise></c:choose> · 等待 <c:out value="${automation.waitMinutes}"/> 分钟</p><p>模板：<c:out value="${automation.templateName}" default="—"/></p><p>发送 <c:out value="${automation.sentCount}"/> · 送达 <c:out value="${automation.deliveredCount}"/> · 订单 <c:out value="${automation.orderCount}"/></p>
    <div class="ma-actions"><button type="button" class="ma-secondary" data-automation-view disabled>查看详情</button><c:if test="${canManageCampaigns}"><button type="button" class="ma-secondary" data-automation-edit disabled>编辑规则</button>
      <c:if test="${automation.status eq 'ACTIVE' or automation.status eq 'DRAFT' or automation.status eq 'PAUSED'}"><form method="post" action="${ctx}/mobile/automations/action" data-automation-action data-confirm-message="${automation.status eq 'ACTIVE' ? '确认暂停自动营销？' : '确认启用自动营销？启用后符合规则的客户可能收到邮件。'}"><input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><input type="hidden" name="automationId" value="<c:out value='${automation.automationId}'/>"><input type="hidden" name="target" value="${automation.status eq 'ACTIVE' ? 'PAUSED' : 'ACTIVE'}"><button type="submit" class="ma-secondary" disabled><c:choose><c:when test="${automation.status eq 'ACTIVE'}">暂停</c:when><c:otherwise>启用</c:otherwise></c:choose></button></form></c:if></c:if></div>
  </article></c:forEach></c:otherwise></c:choose></section>
  <div class="ma-pagination"><c:url var="prevUrl" value="/mobile/automations"><c:param name="shop" value="${selectedShop}"/><c:param name="name" value="${automationNameFilter}"/><c:param name="status" value="${automationStatusFilter}"/><c:param name="triggerEvent" value="${automationTriggerFilter}"/><c:param name="page" value="${automationPage.page - 1}"/></c:url><c:url var="nextUrl" value="/mobile/automations"><c:param name="shop" value="${selectedShop}"/><c:param name="name" value="${automationNameFilter}"/><c:param name="status" value="${automationStatusFilter}"/><c:param name="triggerEvent" value="${automationTriggerFilter}"/><c:param name="page" value="${automationPage.page + 1}"/></c:url><c:if test="${automationPage.hasPrevious}"><a href="<c:out value='${prevUrl}'/>">上一页</a></c:if><span>第 <c:out value="${automationPage.page}"/> / <c:out value="${automationPage.totalPages}"/> 页</span><c:if test="${automationPage.hasNext}"><a href="<c:out value='${nextUrl}'/>">下一页</a></c:if></div>
  <section class="ma-panel" data-automation-detail hidden aria-live="polite"><div class="ma-heading"><h2>旅程详情</h2><button type="button" class="ma-link" data-detail-close>收起</button></div><p role="status" data-detail-state></p><div data-detail-content hidden><h3 data-detail-name></h3><dl class="ma-definition" data-detail-definition></dl><h3>执行数据</h3><div class="ma-metrics" data-detail-metrics></div><h3>GA4 活动评估</h3><p data-detail-ga4></p><h3>客户旅程</h3><form data-detail-filter class="ma-filter"><label>客户<input name="q" placeholder="姓名、邮箱或 ID"></label><label>状态<select name="lifecycle"><option value="ALL">全部</option><option value="PENDING">待处理</option><option value="ACCEPTED">已接受</option><option value="DELIVERED">已送达</option><option value="OPENED">已打开</option><option value="CLICKED">已点击</option><option value="CONVERTED">已下单</option><option value="FAILED">失败</option><option value="BOUNCED">退信</option></select></label><button type="submit" class="ma-secondary">查询</button></form><div data-detail-journeys></div><div class="ma-pagination"><button type="button" class="ma-link" data-journey-prev>上一页</button><span data-journey-page></span><button type="button" class="ma-link" data-journey-next>下一页</button></div></div></section>
  <c:if test="${canManageCampaigns}"><section class="ma-panel" data-automation-editor hidden><div class="ma-heading"><h2 data-editor-title>新建自动营销</h2><button type="button" class="ma-link" data-editor-close>关闭</button></div><p role="alert" class="ma-error" data-editor-error hidden></p>
    <form method="post" action="${ctx}/mobile/automations" data-automation-editor-form data-automation-action data-requires-ready="true" data-ready="false" data-confirm-message="确认保存自动营销规则？"><input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><input type="hidden" name="automationId" value=""><input type="hidden" name="page" value="<c:out value='${automationPage.page}'/>"><input type="hidden" name="status" value="PAUSED"><input type="hidden" name="couponValue" value="">
      <p data-editor-status>新建规则默认禁用；保存后可单独启用。</p><label>规则名称<input name="name" maxlength="255" required></label>
      <label>旅程类型<select name="journeyType" required><c:forEach items="${journeyTypes}" var="type"><option value="<c:out value='${type}'/>"><c:choose><c:when test="${type eq 'ABANDONED_CART'}">购物车挽回</c:when><c:when test="${type eq 'BROWSE_ABANDONMENT'}">浏览挽回</c:when><c:when test="${type eq 'POST_PURCHASE'}">购买后跟进</c:when><c:otherwise><c:out value="${type}"/></c:otherwise></c:choose></option></c:forEach></select></label>
      <label>触发事件<select name="triggerEvent" required><c:forEach items="${behaviorEventTypes}" var="event"><option value="<c:out value='${event}'/>"><c:choose><c:when test="${event eq 'PAGE_VIEWED'}">浏览页面</c:when><c:when test="${event eq 'CLICKED'}">点击页面</c:when><c:when test="${event eq 'PRODUCT_VIEWED'}">查看商品</c:when><c:when test="${event eq 'SEARCH_SUBMITTED'}">提交搜索</c:when><c:when test="${event eq 'PRODUCT_ADDED_TO_CART'}">加入购物车</c:when><c:when test="${event eq 'CHECKOUT_STARTED'}">开始结账</c:when><c:when test="${event eq 'CHECKOUT_COMPLETED'}">完成结账</c:when><c:otherwise><c:out value="${event}"/></c:otherwise></c:choose></option></c:forEach></select></label>
      <label>等待时间（分钟）<input type="number" name="waitMinutes" min="1" max="43200" value="30" required></label><label>同一客户频控（天）<input type="number" name="frequencyDays" min="0" max="365" value="7" required><small>0 表示不限制。</small></label>
      <label>邮件模板<select name="templateId" required><option value="">请选择模板</option><c:forEach items="${templates}" var="template"><c:if test="${template.status eq 'PUBLISHED'}"><option value="<c:out value='${template.templateId}'/>"><c:out value="${template.name}"/></option></c:if></c:forEach></select></label>
      <label>发送通道<select name="provider" required><option value="">请选择通道</option><c:forEach items="${senderSettings}" var="setting"><option value="<c:out value='${setting.provider}'/>" data-sender="<c:out value='${setting.fromHeader}'/>"><c:out value="${providerAliases[setting.provider]}" default="${setting.provider}"/></option></c:forEach></select></label><p data-sender-preview></p>
      <label>优惠券<select name="couponMode"><option value="NONE">不使用优惠券</option><option value="FIXED_CODE">使用固定优惠码</option></select></label><div data-coupon-fields hidden><label>搜索优惠券<input type="search" data-coupon-query></label><button type="button" class="ma-secondary" data-coupon-search>搜索</button><label>固定优惠券<select name="discountSourceId"><option value="">请选择有效优惠券</option></select></label><p role="status" data-coupon-state></p></div>
      <details><summary>归因设置</summary><label>UTM 来源<input name="utmSource" value="auw" maxlength="128" required></label><label>UTM 媒介<input name="utmMedium" value="email" maxlength="128" required></label><label>UTM 活动<input name="utmCampaign" maxlength="255"></label><label>UTM 内容<input name="utmContent" maxlength="255"></label></details>
      <label class="ma-check"><input name="exitOnPurchase" type="checkbox" value="true" checked>客户购买后退出等待中的旅程</label><button type="submit" class="ma-primary" disabled>保存规则</button>
    </form></section></c:if>
  </c:otherwise></c:choose>
</main><%@ include file="fragments/footer.jspf" %><script src="${ctx}/shopify/mobile/automations.js?v=20261108-5" defer></script></body></html>
