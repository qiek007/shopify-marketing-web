<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/><c:set var="mobilePage" value="segments"/>
<c:url var="listUrl" value="/mobile/segments"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${param.q}"/><c:param name="page" value="${param.page}"/></c:url>
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>分群规则 · 滴答营销</title><link rel="stylesheet" href="${ctx}/shopify/mobile/mobile.css"><link rel="stylesheet" href="${ctx}/shopify/mobile/segments.css?v=20261110-borderless"></head><body>
<%@ include file="fragments/header.jspf" %><main class="mobile-main">
<p><a class="ms-button" href="<c:out value='${listUrl}'/>">← 返回分群列表</a></p><section class="mobile-page-title"><p class="mobile-eyebrow">SEGMENT / 客户分群</p><h1><c:choose><c:when test="${editorSegment.existing}">查看 / 编辑分群</c:when><c:otherwise>新建分群</c:otherwise></c:choose></h1><p>组内、组间均可选择全部满足或任一满足，最多 20 条条件。</p></section>
<c:if test="${not empty errorMessage}"><p class="mobile-notice error" role="alert"><c:out value="${errorMessage}"/></p></c:if>
<form id="mobile-segment-form" class="ms-form" method="post" action="${ctx}/mobile/segments" data-preview-url="${ctx}/mobile/segments/preview/results">
    <input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><input type="hidden" name="segmentId" value="<c:out value='${editorSegment.segmentId}'/>">
    <fieldset <c:if test="${not canManageCampaigns}">disabled</c:if>>
    <label>分群名称<input type="text" name="name" required maxlength="255" value="<c:out value='${editorSegment.name}'/>" placeholder="例如：近 30 天复购客户"></label>
    <label>条件组之间<select name="matchMode"><option value="ALL" <c:if test="${editorSegment.matchMode eq 'ALL'}">selected</c:if>>全部满足（且）</option><option value="ANY" <c:if test="${editorSegment.matchMode eq 'ANY'}">selected</c:if>>任一满足（或）</option></select></label>
    <p class="ms-note">已有规则不会因打开页面自动改变；需要调整行为次数规则时，请先点击“调整行为条件”。邮件打开数据可能受邮箱隐私代理影响。</p>
    <div id="mobile-segment-groups">
    <c:choose><c:when test="${empty editorSegment.groups}">
        <section class="ms-group segment-rule-group" data-group-id="group-1"><h2>条件组</h2><input type="hidden" name="groupIds" value="group-1"><label>组内关系<select name="groupMatchModes"><option value="ALL">全部满足（且）</option><option value="ANY">任一满足（或）</option></select></label><div class="segment-group-rules"><div class="ms-row segment-rule-row" data-new-rule="true"><input type="hidden" name="ruleGroupIds" value="group-1"><label>字段<select name="fields" data-segment-options-grouped="true"><%@ include file="../shopify-theme2/fragments/segment-field-options.jspf" %><%@ include file="fragments/segment-behavior-options.jspf" %></select></label><label>比较<select name="operators"><%@ include file="../shopify-theme2/fragments/segment-operator-options.jspf" %></select></label><label>条件值<input name="values" value="true" required></label><button type="button" class="ms-button remove-rule">删除条件</button></div></div><div class="ms-buttons"><button type="button" class="ms-button add-group-rule">添加条件</button><button type="button" class="ms-button remove-group">删除条件组</button></div></section>
    </c:when><c:otherwise><c:forEach items="${editorSegment.groups}" var="group"><section class="ms-group segment-rule-group" data-group-id="<c:out value='${group.groupId}'/>"><h2>条件组</h2><input type="hidden" name="groupIds" value="<c:out value='${group.groupId}'/>"><label>组内关系<select name="groupMatchModes"><option value="ALL" <c:if test="${group.matchMode eq 'ALL'}">selected</c:if>>全部满足（且）</option><option value="ANY" <c:if test="${group.matchMode eq 'ANY'}">selected</c:if>>任一满足（或）</option></select></label><div class="segment-group-rules">
        <c:forEach items="${group.rules}" var="rule"><div class="ms-row segment-rule-row"><input type="hidden" name="ruleGroupIds" value="<c:out value='${group.groupId}'/>"><label>字段<select name="fields" data-segment-options-grouped="true"><option value="<c:out value='${rule.field}'/>" selected hidden data-original-option="true"><c:out value="${rule.field}"/></option><%@ include file="../shopify-theme2/fragments/segment-field-options.jspf" %><%@ include file="fragments/segment-behavior-options.jspf" %></select></label><label>比较<select name="operators"><option value="<c:out value='${rule.operator}'/>" selected hidden data-original-option="true"><c:out value="${rule.operator}"/></option><%@ include file="../shopify-theme2/fragments/segment-operator-options.jspf" %></select></label><label>条件值<input name="values" value="<c:out value='${rule.value}'/>" required></label><c:if test="${rule.field eq 'BEHAVIOR_METRIC' or rule.field eq 'BEHAVIOR_PRODUCT_VIEWED' or rule.field eq 'BEHAVIOR_PRODUCT_ADDED_TO_CART' or rule.field eq 'BEHAVIOR_ORDER_COMPLETED' or rule.field eq 'BEHAVIOR_EMAIL_DELIVERED' or rule.field eq 'BEHAVIOR_EMAIL_OPENED' or rule.field eq 'BEHAVIOR_EMAIL_CLICKED' or rule.field eq 'BEHAVIOR_EMAIL_FAILED'}"><button type="button" class="ms-button edit-metric">调整行为条件</button></c:if><button type="button" class="ms-button remove-rule">删除条件</button></div></c:forEach>
        </div><div class="ms-buttons"><button type="button" class="ms-button add-group-rule">添加条件</button><button type="button" class="ms-button remove-group">删除条件组</button></div></section></c:forEach></c:otherwise></c:choose>
    </div>
    <c:if test="${canManageCampaigns}"><div class="ms-buttons"><button type="button" class="ms-button" id="mobile-add-group" disabled>添加条件组</button><button type="button" class="ms-button" id="mobile-segment-preview" disabled>预览客户</button><button type="submit" class="ms-button primary" id="mobile-segment-save" disabled><c:choose><c:when test="${editorSegment.existing}">保存修改</c:when><c:otherwise>创建分群</c:otherwise></c:choose></button></div></c:if>
    </fieldset>
</form><p id="mobile-segment-notice" class="ms-note" role="status" aria-live="polite"></p><div id="mobile-segment-results" aria-live="polite"></div>
<c:remove var="rule"/>
<template id="mobile-rule-template"><div class="ms-row segment-rule-row"><input type="hidden" name="ruleGroupIds"><label>字段<select name="fields" data-segment-options-grouped="true"><%@ include file="../shopify-theme2/fragments/segment-field-options.jspf" %><%@ include file="fragments/segment-behavior-options.jspf" %></select></label><label>比较<select name="operators"><%@ include file="../shopify-theme2/fragments/segment-operator-options.jspf" %></select></label><label>条件值<input name="values" value="true" required></label><button type="button" class="ms-button remove-rule">删除条件</button></div></template>
<template id="mobile-group-template"><section class="ms-group segment-rule-group"><h2>条件组</h2><input type="hidden" name="groupIds"><label>组内关系<select name="groupMatchModes"><option value="ALL">全部满足（且）</option><option value="ANY">任一满足（或）</option></select></label><div class="segment-group-rules"></div><div class="ms-buttons"><button type="button" class="ms-button add-group-rule">添加条件</button><button type="button" class="ms-button remove-group">删除条件组</button></div></section></template>
</main><%@ include file="fragments/footer.jspf" %><script src="${ctx}/shopify/js/segment-behavior-metric.js?v=20261011-p3" defer></script><script src="${ctx}/shopify/mobile/segments.js?v=20261108-flow" defer></script></body></html>
