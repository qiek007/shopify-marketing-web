<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/><c:set var="mobilePage" value="customers"/>
<c:url var="customerListUrl" value="/mobile/customers"><c:param name="shop" value="${selectedShop}"/><c:param name="q" value="${param.q}"/><c:param name="activity" value="${param.activity}"/><c:forEach items="${paramValues.tag}" var="tag"><c:param name="tag" value="${tag}"/></c:forEach><c:param name="fromDate" value="${param.fromDate}"/><c:param name="toDate" value="${param.toDate}"/><c:param name="minSpent" value="${param.minSpent}"/><c:param name="maxSpent" value="${param.maxSpent}"/><c:param name="minBehaviorCount" value="${param.minBehaviorCount}"/><c:param name="maxBehaviorCount" value="${param.maxBehaviorCount}"/><c:param name="minUniqueBehaviorCount" value="${param.minUniqueBehaviorCount}"/><c:param name="maxUniqueBehaviorCount" value="${param.maxUniqueBehaviorCount}"/><c:param name="page" value="${param.page}"/></c:url>
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>客户详情 · 滴答营销</title><link rel="stylesheet" href="${ctx}/shopify/mobile/mobile.css?v=20261108-customers2"><link rel="stylesheet" href="${ctx}/shopify/mobile/customers.css?v=20261108-flow2"></head><body>
<%@ include file="fragments/header.jspf" %>
<main class="mobile-main">
    <p><a class="mc-button" data-mobile-customer-return href="<c:out value='${customerListUrl}'/>">← 返回客户列表</a></p>
    <section class="mobile-page-title"><p class="mobile-eyebrow">CUSTOMER / 客户详情</p><h1><c:out value="${customerDetail.customer.displayName}"/></h1><p><c:out value="${customerDetail.customer.email}"/></p></section>
    <section class="mc-section"><h2>客户概览</h2><div class="mc-row"><span class="mc-tag"><c:choose><c:when test="${customerDetail.customer.consentState eq 'SUBSCRIBED'}">已订阅</c:when><c:when test="${customerDetail.customer.consentState eq 'NOT_SUBSCRIBED'}">未订阅</c:when><c:when test="${customerDetail.customer.consentState eq 'UNSUBSCRIBED'}">已退订</c:when><c:when test="${empty customerDetail.customer.consentState or customerDetail.customer.consentState eq 'UNKNOWN'}">未知</c:when><c:otherwise><c:out value="${customerDetail.customer.consentState}"/></c:otherwise></c:choose></span><c:if test="${customerDetail.customer.suppressed}"><span class="mc-tag">已抑制</span></c:if><c:forEach items="${customerDetail.customer.tags}" var="tag"><span class="mc-tag"><c:out value="${tag}"/></span></c:forEach></div>
        <div class="mc-stats"><div class="mc-stat"><span>成交订单</span><strong><c:out value="${customerDetail.customer.orderCount}"/></strong></div><div class="mc-stat"><span>累计消费</span><strong><c:out value="${customerDetail.customer.currency}"/> <c:out value="${customerDetail.customer.totalSpent}"/></strong></div><div class="mc-stat"><span>最近成交</span><strong><time data-browser-time="<c:out value='${customerDetail.customer.lastOrderAt}'/>" datetime="<c:out value='${customerDetail.customer.lastOrderAt}'/>"><c:out value="${customerDetail.customer.lastOrderAt}" default="暂无"/></time></strong></div><div class="mc-stat"><span>最近活跃</span><strong><time data-browser-time="<c:out value='${customerDetail.lastActivityAt}'/>" datetime="<c:out value='${customerDetail.lastActivityAt}'/>"><c:out value="${customerDetail.lastActivityAt}" default="暂无"/></time></strong></div></div>
        <p class="mc-meta">地区语言：<c:out value="${customerDetail.locale}" default="—"/> · 购买频次：<c:out value="${customerDetail.frequency}" default="0"/> · RFM 消费额：<c:out value="${customerDetail.monetary}" default="—"/></p>
        <p class="mc-meta">来源：<c:choose><c:when test="${customerDetail.customer.sourceType eq 'IMPORTED'}">文件导入</c:when><c:otherwise>Shopify · <c:out value="${customerDetail.stateLabel}"/></c:otherwise></c:choose></p>
    </section>
    <details class="mc-section"><summary>最近订单（最多 100 笔） · 已展示 <c:out value="${customerDetail.orders.size()}" default="0"/> 笔</summary><c:choose><c:when test="${empty customerDetail.orders}"><p>暂无成交订单。</p></c:when><c:otherwise><c:forEach items="${customerDetail.orders}" var="order"><article class="mc-order"><strong><c:out value="${order.orderName}"/></strong><p><c:out value="${order.currency}"/> <c:out value="${order.totalPrice}"/> · 商品 <c:out value="${order.totalQuantity}"/> 件</p><p class="mc-meta">财务：<c:out value="${order.financialStatus}"/> · 履约：<c:out value="${order.fulfillmentStatus}"/> · 优惠：<c:out value="${order.totalDiscounts}"/></p><time class="mc-meta" data-browser-time="<c:out value='${order.processedAt}'/>" datetime="<c:out value='${order.processedAt}'/>"><c:out value="${order.processedAt}"/></time></article></c:forEach></c:otherwise></c:choose></details>
    <section class="mc-section"><h2>客户行为时间线</h2>
        <form id="mobile-customer-timeline-filter" class="mc-form" method="get" action="${ctx}/mobile/customers/detail">
            <input type="hidden" name="shop" value="<c:out value='${selectedShop}'/>"><input type="hidden" name="customerId" value="<c:out value='${customerDetail.customer.sourceId}'/>">
            <input type="hidden" name="q" value="<c:out value='${param.q}'/>"><input type="hidden" name="activity" value="<c:out value='${param.activity}'/>"><c:forEach items="${paramValues.tag}" var="tag"><input type="hidden" name="tag" value="<c:out value='${tag}'/>"></c:forEach>
            <input type="hidden" name="fromDate" value="<c:out value='${param.fromDate}'/>"><input type="hidden" name="toDate" value="<c:out value='${param.toDate}'/>"><input type="hidden" name="minSpent" value="<c:out value='${param.minSpent}'/>"><input type="hidden" name="maxSpent" value="<c:out value='${param.maxSpent}'/>"><input type="hidden" name="minBehaviorCount" value="<c:out value='${param.minBehaviorCount}'/>"><input type="hidden" name="maxBehaviorCount" value="<c:out value='${param.maxBehaviorCount}'/>"><input type="hidden" name="minUniqueBehaviorCount" value="<c:out value='${param.minUniqueBehaviorCount}'/>"><input type="hidden" name="maxUniqueBehaviorCount" value="<c:out value='${param.maxUniqueBehaviorCount}'/>"><input type="hidden" name="page" value="<c:out value='${param.page}'/>">
            <label>查询日期<span class="mc-range"><input type="date" name="timelineFromDate" aria-label="时间线开始日期" value="<c:out value='${timelineWindow.fromDate}'/>" required><input type="date" name="timelineToDate" aria-label="时间线结束日期" value="<c:out value='${timelineWindow.toDate}'/>" required></span></label><p id="mobile-timeline-error" class="mc-hint" role="alert" hidden></p><button class="mc-button" type="submit">查询时间线</button>
        </form>
        <c:choose><c:when test="${timelineWindow.unavailable}"><p class="mc-alert" role="alert">时间线暂不可用，无法据此判断客户没有行为，请稍后重试。</p></c:when><c:when test="${empty timelineWindow.completeGroups}"><p><c:choose><c:when test="${timelineWindow.synchronizing}">当前尚无已同步的行为记录。</c:when><c:otherwise>所选时间内暂无行为记录。</c:otherwise></c:choose></p></c:when><c:otherwise>
            <p class="mc-meta"><c:out value="${timelineWindow.fromDate}"/> 至 <c:out value="${timelineWindow.toDate}"/> · <c:out value="${timelineWindow.totalCount}"/> 项行为</p>
            <c:forEach items="${timelineWindow.completeGroups}" var="group"><details <c:if test="${not group.collapsed}">open</c:if>><summary><c:out value="${group.title}"/> · <c:out value="${group.count}"/> 条</summary><c:forEach items="${group.activities}" var="activity"><article class="mc-event"><strong><c:out value="${activity.title}"/></strong><p><c:out value="${activity.description}"/></p><p class="mc-meta"><c:out value="${activity.type}"/> · <time data-browser-time="<c:out value='${activity.occurredAt}'/>" datetime="<c:out value='${activity.occurredAt}'/>"><c:out value="${activity.occurredAt}"/></time></p></article></c:forEach></details></c:forEach>
            <c:if test="${timelineWindow.hasMore}"><p class="mc-alert">当前记录未全部展示，请使用电脑端查看更多。</p></c:if>
        </c:otherwise></c:choose>
    </section>
</main><%@ include file="fragments/footer.jspf" %><script src="${ctx}/shopify/mobile/customers.js?v=20261108-customers2" defer></script></body></html>
