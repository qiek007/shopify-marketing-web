<%@ page pageEncoding="UTF-8" %>
<c:choose>
    <c:when test="${not empty customerDetail.updatedAt}">
        <time data-browser-time="<c:out value='${customerDetail.updatedAt}'/>" data-browser-time-format="date-time" datetime="<c:out value='${customerDetail.updatedAt}'/>"><c:out value="${customerDetail.updatedAt}"/></time>
    </c:when>
    <c:otherwise>—</c:otherwise>
</c:choose>
