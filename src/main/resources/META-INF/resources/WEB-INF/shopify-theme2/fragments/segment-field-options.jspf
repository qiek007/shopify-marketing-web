<%@ page pageEncoding="UTF-8" %><option value="ALL_CUSTOMERS" ${rule.field eq 'ALL_CUSTOMERS' ? 'selected' : ''}>全部客户</option><option value="SEARCH_TEXT" ${rule.field eq 'SEARCH_TEXT' ? 'selected' : ''}>姓名或邮箱</option><option value="CONSENT_STATE" ${rule.field eq 'CONSENT_STATE' ? 'selected' : ''}>营销订阅状态</option><option value="ORDER_COUNT" ${rule.field eq 'ORDER_COUNT' ? 'selected' : ''}>订单数</option><option value="TOTAL_SPENT" ${rule.field eq 'TOTAL_SPENT' ? 'selected' : ''}>累计有效订单金额</option><option value="TAG" ${rule.field eq 'TAG' ? 'selected' : ''}>客户标签</option><option value="NO_TAG" ${rule.field eq 'NO_TAG' ? 'selected' : ''}>无标签</option><option value="LAST_ORDER_AT" ${rule.field eq 'LAST_ORDER_AT' ? 'selected' : ''}>最近有效订单时间</option><option value="RECENCY_DAYS" ${rule.field eq 'RECENCY_DAYS' ? 'selected' : ''}>距最近下单天数</option><option value="LAST_ACTIVITY_AT" ${rule.field eq 'LAST_ACTIVITY_AT' ? 'selected' : ''}>最近活动时间</option><option value="CUSTOMER_CREATED_AT" ${rule.field eq 'CUSTOMER_CREATED_AT' ? 'selected' : ''}>客户创建时间</option><option value="EMAIL" ${rule.field eq 'EMAIL' ? 'selected' : ''}>邮箱</option><option value="CUSTOMER_NAME" ${rule.field eq 'CUSTOMER_NAME' ? 'selected' : ''}>客户姓名</option><option value="LOCALE" ${rule.field eq 'LOCALE' ? 'selected' : ''}>语言地区</option><option value="ACCOUNT_STATE" ${rule.field eq 'ACCOUNT_STATE' ? 'selected' : ''}>Shopify账号状态</option><option value="WEB_VIEWED_AT" ${rule.field eq 'WEB_VIEWED_AT' ? 'selected' : ''}>浏览商品时间</option><option value="WEB_CARTED_AT" ${rule.field eq 'WEB_CARTED_AT' ? 'selected' : ''}>加入购物车时间</option><option value="EMAIL_DELIVERED_AT" ${rule.field eq 'EMAIL_DELIVERED_AT' ? 'selected' : ''}>邮件送达时间</option><option value="EMAIL_OPENED_AT" ${rule.field eq 'EMAIL_OPENED_AT' ? 'selected' : ''}>邮件打开时间</option><option value="EMAIL_CLICKED_AT" ${rule.field eq 'EMAIL_CLICKED_AT' ? 'selected' : ''}>邮件点击时间</option><option value="EMAIL_FAILED_AT" ${rule.field eq 'EMAIL_FAILED_AT' ? 'selected' : ''}>邮件失败/退信时间</option><option value="EMAIL_DELIVERED_NOT_OPENED_AT" ${rule.field eq 'EMAIL_DELIVERED_NOT_OPENED_AT' ? 'selected' : ''}>最近送达未打开</option><option value="EMAIL_OPENED_NOT_CLICKED_AT" ${rule.field eq 'EMAIL_OPENED_NOT_CLICKED_AT' ? 'selected' : ''}>最近打开未点击</option>
