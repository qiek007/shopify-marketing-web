<%@ page pageEncoding="UTF-8" %><option value="EQ" ${rule.operator eq 'EQ' ? 'selected' : ''}>等于</option><option value="NE" ${rule.operator eq 'NE' ? 'selected' : ''}>不等于</option><option value="GTE" ${rule.operator eq 'GTE' ? 'selected' : ''}>大于等于</option><option value="LTE" ${rule.operator eq 'LTE' ? 'selected' : ''}>小于等于</option><option value="CONTAINS" ${rule.operator eq 'CONTAINS' ? 'selected' : ''}>包含</option><option value="BEFORE" ${rule.operator eq 'BEFORE' ? 'selected' : ''}>早于</option><option value="AFTER" ${rule.operator eq 'AFTER' ? 'selected' : ''}>晚于</option><option value="ON_OR_AFTER" ${rule.operator eq 'ON_OR_AFTER' ? 'selected' : ''}>不早于</option><option value="EXISTS" ${rule.operator eq 'EXISTS' ? 'selected' : ''}>存在</option>
