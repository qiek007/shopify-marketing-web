<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:choose><c:when test="${empty productOrders.items}"><div class="empty-state compact"><i class="fa fa-file-text-o"></i><strong>暂无关联订单</strong></div></c:when><c:otherwise>
<div class="table-wrap"><table class="status-table"><thead><tr><th>订单</th><th>客户</th><th>商品数量</th><th>财务状态</th><th>履约状态</th><th>订单金额</th><th>成交时间</th></tr></thead><tbody>
<c:forEach items="${productOrders.items}" var="order"><tr><td><strong><c:out value="${order.orderName}"/></strong></td><td><c:choose><c:when test="${canViewCustomers and not empty order.customerSourceId}"><c:url var="customerPageUrl" value="/customers/detail"><c:param name="shop" value="${selectedShop}"/><c:param name="customerId" value="${order.customerSourceId}"/></c:url><c:url var="customerDetailUrl" value="/campaigns/detail/customer"><c:param name="shop" value="${selectedShop}"/><c:param name="customerId" value="${order.customerSourceId}"/></c:url><a class="table-link" href="${customerPageUrl}" data-customer-detail-url="${customerDetailUrl}" data-customer-name="<c:out value='${order.customerName}'/>"><strong><c:out value="${order.customerName}" default="未命名客户"/></strong><span class="cell-note"><c:out value="${order.customerEmail}" default="-"/></span></a></c:when><c:otherwise><strong><c:out value="${order.customerName}" default="未命名客户"/></strong><span class="cell-note"><c:out value="${order.customerEmail}" default="访客订单"/></span></c:otherwise></c:choose></td><td><c:out value="${order.productQuantity}"/></td><td><c:out value="${order.financialStatus}"/></td><td><c:out value="${order.fulfillmentStatus}"/></td><td><c:out value="${order.currency}"/> <c:out value="${order.totalPrice}"/></td><td><time data-browser-time="<c:out value='${order.processedAt}'/>" datetime="<c:out value='${order.processedAt}'/>"><c:out value="${order.processedAt}"/></time></td></tr></c:forEach>
</tbody></table></div>
<div class="pagination-bar"><c:if test="${productOrders.hasPrevious}"><button class="action-button" type="button" data-product-orders-page="${productOrders.page - 1}">上一页</button></c:if><span>共 <c:out value="${productOrders.total}"/> 项，第 <c:out value="${productOrders.page}"/> / <c:out value="${productOrders.totalPages}"/> 页</span><c:if test="${productOrders.hasNext}"><button class="action-button" type="button" data-product-orders-page="${productOrders.page + 1}">下一页</button></c:if></div>
</c:otherwise></c:choose>
