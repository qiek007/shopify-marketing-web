<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>订单 - Shopify 邮件营销</title><c:set var="ctx" value="${pageContext.request.contextPath}"/><link rel="stylesheet" href="${ctx}/baseui/static/h-ui/css/H-ui.min.css"><link rel="stylesheet" href="${ctx}/baseui/static/h-ui.admin/css/H-ui.admin.css"><link rel="stylesheet" href="${ctx}/baseui/lib/font-awesome-4.7.0/css/font-awesome.min.css"><link rel="stylesheet" href="${ctx}${uiAssetBase}/css/dashboard.css"></head><body class="shopify-console"><%@ include file="fragments/header.jspf" %><div class="console-layout"><%@ include file="fragments/navigation.jspf" %><main class="console-main"><section class="page-heading"><div><p class="eyebrow">店铺数据</p><h1>订单</h1><p>查看当前店铺的订单金额、状态和客户归属</p></div></section><section class="content-section"><form class="filter-form" method="get"><input type="hidden" name="shop" value="${selectedShop}"><input name="q" value="<c:out value='${search}'/>" placeholder="订单号、邮箱、状态或 ID"><button class="action-button" type="submit"><i class="fa fa-search"></i><span>查询</span></button></form><c:choose><c:when test="${empty orders.items}"><div class="empty-state"><i class="fa fa-file-text-o"></i><strong>没有找到订单</strong><span>可调整查询条件，或等待订单同步完成。</span></div></c:when><c:otherwise><div class="table-wrap"><table class="status-table"><thead><tr><th>订单</th><th>客户</th><th>财务状态</th><th>履约状态</th><th>商品项/数量</th><th>优惠</th><th>总金额</th><th>成交时间</th></tr></thead><tbody><c:forEach items="${orders.items}" var="order"><tr><td><strong><c:out value="${order.orderName}"/></strong><span class="cell-note"><c:out value="${order.sourceId}"/></span></td><td><c:choose><c:when test="${not empty order.customerSourceId}"><a class="table-link" href="${ctx}/customers/detail?shop=${selectedShop}&customerId=${order.customerSourceId}"><c:out value="${order.email}" default="查看客户"/></a></c:when><c:otherwise><c:out value="${order.email}" default="访客订单"/></c:otherwise></c:choose></td><td><c:out value="${order.financialStatus}"/></td><td><c:out value="${order.fulfillmentStatus}"/></td><td><c:out value="${order.lineItemCount}"/> / <c:out value="${order.totalQuantity}"/></td><td><c:out value="${order.totalDiscounts}"/></td><td><c:out value="${order.currency}"/> <c:out value="${order.totalPrice}"/></td><td><time data-browser-time="<c:out value='${order.processedAt}'/>" datetime="<c:out value='${order.processedAt}'/>"><c:out value="${order.processedAt}"/></time></td></tr></c:forEach></tbody></table></div><div class="pagination-bar"><c:if test="${orders.hasPrevious}"><a class="action-button" href="${ctx}/orders?shop=${selectedShop}&q=${search}&page=${orders.page - 1}&size=${orders.pageSize}">上一页</a></c:if><span>共 <c:out value="${orders.total}"/> 项，第 <c:out value="${orders.page}"/> / <c:out value="${orders.totalPages}"/> 页</span><c:if test="${orders.hasNext}"><a class="action-button" href="${ctx}/orders?shop=${selectedShop}&q=${search}&page=${orders.page + 1}&size=${orders.pageSize}">下一页</a></c:if></div></c:otherwise></c:choose></section></main></div></body></html>
