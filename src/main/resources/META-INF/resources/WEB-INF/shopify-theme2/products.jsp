<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ page language="java" pageEncoding="UTF-8" contentType="text/html; charset=UTF-8" %>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>商品 - Shopify 邮件营销</title><c:set var="ctx" value="${pageContext.request.contextPath}"/><link rel="stylesheet" href="${ctx}/baseui/static/h-ui/css/H-ui.min.css"><link rel="stylesheet" href="${ctx}/baseui/static/h-ui.admin/css/H-ui.admin.css"><link rel="stylesheet" href="${ctx}/baseui/lib/font-awesome-4.7.0/css/font-awesome.min.css"><link rel="stylesheet" href="${ctx}${uiAssetBase}/css/dashboard.css"></head><body class="shopify-console"><%@ include file="fragments/header.jspf" %><div class="console-layout"><%@ include file="fragments/navigation.jspf" %><main class="console-main"><section class="page-heading"><div><p class="eyebrow">店铺数据</p><h1>商品</h1><p>查看当前店铺的商品、价格、库存和成交情况</p></div></section><section class="content-section"><form class="filter-form" method="get"><input type="hidden" name="shop" value="${selectedShop}"><input type="hidden" name="page" value="1"><input type="hidden" name="size" value="${products.pageSize}"><input name="q" value="<c:out value='${search}'/>" placeholder="商品名称、品牌、类型或 ID"><button class="action-button" type="submit"><i class="fa fa-search"></i><span>查询</span></button></form><c:choose><c:when test="${empty products.items}"><div class="empty-state"><i class="fa fa-tags"></i><strong>没有找到商品</strong><span>可调整查询条件，或等待店铺商品同步完成。</span></div></c:when><c:otherwise><div class="table-wrap"><table class="status-table"><thead><tr><th>商品</th><th>状态</th><th>价格</th><th>库存</th><th>变体</th><th>订单</th><th>销量</th><th>销售额</th></tr></thead><tbody><c:forEach items="${products.items}" var="product"><c:url var="productDetailUrl" value="/products/detail"><c:param name="shop" value="${selectedShop}"/><c:param name="productId" value="${product.sourceId}"/><c:param name="q" value="${search}"/><c:param name="page" value="${products.page}"/><c:param name="size" value="${products.pageSize}"/></c:url><tr><td><a class="table-link" href="${productDetailUrl}"><strong><c:out value="${product.title}"/></strong></a><span class="cell-note"><c:out value="${product.vendor}"/> · <c:out value="${product.productType}"/></span></td><td><span class="status-pill"><c:out value="${product.status}"/></span></td><td><c:out value="${product.minPrice}"/> - <c:out value="${product.maxPrice}"/></td><td><c:out value="${product.inventoryQuantity}"/></td><td><c:out value="${product.variantCount}"/></td><td><c:out value="${product.orderCount}"/></td><td><c:out value="${product.unitsSold}"/></td><td><c:out value="${product.currency}"/> <c:out value="${product.grossSales}"/></td></tr></c:forEach></tbody></table></div><div class="pagination-bar"><c:if test="${products.hasPrevious}"><a class="action-button" href="${ctx}/products?shop=${selectedShop}&q=${search}&page=${products.page - 1}&size=${products.pageSize}">上一页</a></c:if><span>共 <c:out value="${products.total}"/> 项，第 <c:out value="${products.page}"/> / <c:out value="${products.totalPages}"/> 页</span><c:if test="${products.hasNext}"><a class="action-button" href="${ctx}/products?shop=${selectedShop}&q=${search}&page=${products.page + 1}&size=${products.pageSize}">下一页</a></c:if></div></c:otherwise></c:choose></section></main></div></body></html>
